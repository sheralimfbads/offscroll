YOUTUBE_API_KEY=
YOUTUBE_CHANNELS_FILE=config/youtube_channels.yaml
OFFSCROLL_SOURCES=hackernews,wikipedia,youtube

# Placeholder values only. Database commands require exported environment variables.
POSTGRES_USER=replace_me_user
POSTGRES_PASSWORD=replace_me_password
POSTGRES_DB=replace_me_database
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://replace_me_user:replace_me_password@127.0.0.1:5432/replace_me_database

# Optional offline summaries. Keep Google Cloud billing DISABLED.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
SUMMARY_APPROVED_INPUTS=config/summary_public_inputs.json
